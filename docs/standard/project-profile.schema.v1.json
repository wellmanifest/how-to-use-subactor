{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/subactor-usage/project-profile.v1.json",
  "title": "Subactor usage project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "projectRef", "requiredInterfaces", "stages", "completion"],
  "properties": {
    "schema": {"const": "wellmanifest.subactor-usage/project-profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "current", "deprecated"]},
    "projectRef": {"type": "string", "pattern": "^project://[^\\s]+$"},
    "requiredInterfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intentId", "operation", "effect", "authority", "requiredInputs", "requiredEvidence", "onFailure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "intentId": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "effect": {"enum": ["observe", "local_write", "external_write", "hardware_write"]},
          "authority": {"enum": ["observe", "plan", "dry_run", "apply", "autonomous"]},
          "requiredInputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "requiredEvidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "onFailure": {"enum": ["stop", "replan", "rollback", "escalate"]}
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "forbids"],
      "properties": {
        "requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "forbids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
