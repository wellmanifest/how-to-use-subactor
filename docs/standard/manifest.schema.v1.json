{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/subactor-usage/manifest.v1.json",
  "title": "Subactor usage standard manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "home", "shape", "runtimeOwner", "communicationSpecification", "artifacts"],
  "properties": {
    "schema": {"const": "wellmanifest.subactor-usage/manifest/v1"},
    "id": {"const": "how-to-use-subactor"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["current", "deprecated"]},
    "home": {"const": "wellmanifest"},
    "shape": {"const": "domain_pack"},
    "runtimeOwner": {"const": "subactor"},
    "communicationSpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "path"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "path", "sha256"],
        "properties": {
          "kind": {"enum": ["interface-profile", "project-profile"]},
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
